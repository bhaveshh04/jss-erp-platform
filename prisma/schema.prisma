
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ActivityLog {
  id        String   @id @default(cuid())
  type      String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt], map: "ActivityLog_createdAt_idx")
  @@map("activitylog")
}

model Attendance {
  id        String    @id @default(cuid())
  userId    String
  date      DateTime  @db.Date
  inTime    DateTime?
  outTime   DateTime?
  inLat     Float?
  inLng     Float?
  outLat    Float?
  outLng    Float?
  createdAt DateTime  @default(now())

user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Attendance_userId_fkey")

  @@unique([userId, date], map: "Attendance_userId_date_key")
  @@index([date], map: "Attendance_date_idx")
  @@map("attendance")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  interest  String?
  message   String
  createdAt DateTime @default(now())

  @@map("contactmessage")
}

model JobApplication {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  position  String
  coverNote String?
  resumeUrl String?
  createdAt DateTime @default(now())

  @@map("jobapplication")
}

model LeaveRequest {
  id           String      @id @default(cuid())
  userId       String
  fromDate     DateTime    @db.Date
  toDate       DateTime    @db.Date
  reason       String
  status       LeaveStatus @default(PENDING)
  reviewedById String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

user User @relation("LeaveRequestUser", fields: [userId], references: [id], onDelete: Cascade, map: "LeaveRequest_userId_fkey")

reviewedBy User? @relation("LeaveRequestReviewer", fields: [reviewedById], references: [id], map: "LeaveRequest_reviewedById_fkey")

  @@index([reviewedById], map: "LeaveRequest_reviewedById_fkey")
  @@index([status], map: "LeaveRequest_status_idx")
  @@index([userId], map: "LeaveRequest_userId_idx")
  @@map("leaverequest")
}

model OfficeSettings {
  id           Int      @id @default(1)
  name         String   @default("JSS Innovative Solutions — Pune HQ")
  lat          Float
  lng          Float
  radiusMeters Int      @default(200)
  updatedAt    DateTime @updatedAt

  @@map("officesettings")
}

model SiteContent {
  id        String   @id @default(cuid())
  section   String   @unique(map: "SiteContent_section_key")
  data      String   @db.LongText
  updatedAt DateTime @updatedAt

  @@map("sitecontent")
}

model Task {
  id           String       @id @default(cuid())
  title        String
  description  String?
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(PENDING)
  dueDate      DateTime?
  assignedToId String
  createdById  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

 assignedTo User @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: Cascade, map: "Task_assignedToId_fkey")

createdBy User @relation("TaskCreatedBy", fields: [createdById], references: [id], map: "Task_createdById_fkey")

  @@index([assignedToId], map: "Task_assignedToId_idx")
  @@index([createdById], map: "Task_createdById_fkey")
  @@index([status], map: "Task_status_idx")
  @@map("task")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique(map: "User_email_key")
  passwordHash String
  role         Role     @default(EMPLOYEE)
  department   String?
  active       Boolean  @default(true)
  mustResetPw  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attendance     Attendance[]
  leaveRequests  LeaveRequest[] @relation("LeaveRequestUser")
  reviewedLeaves LeaveRequest[] @relation("LeaveRequestReviewer")
  assignedTasks  Task[]         @relation("TaskAssignedTo")
  createdTasks   Task[]         @relation("TaskCreatedBy")

  @@index([role], map: "User_role_idx")
  @@map("user")
}

model MediaAsset {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes    @db.LongBlob
  createdAt DateTime @default(now())

  @@map("mediaasset")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("task_priority")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED

  @@map("task_status")
}

enum Role {
  OWNER
  EMPLOYEE

  @@map("user_role")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("leaverequest_status")
}
